# Shared
DATABASE_URL=postgresql://ga4_dashboard:ga4_dashboard@127.0.0.1:5440/ga4_dashboard

# API
API_PORT=3002
CORS_ORIGIN=http://127.0.0.1:5174,http://localhost:5174
GA4_PROPERTY_ID=123456789
GA4_DEFAULT_BACKFILL_DAYS=90
USE_MOCK_GA4=false

# Point to the service account JSON key file downloaded from GCP
GA4_KEY_FILE=/path/to/service-account-key.json

# Or set these directly instead of using GA4_KEY_FILE
# GA4_CLIENT_EMAIL=ga4-service-account@your-project.iam.gserviceaccount.com
# GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Web
VITE_API_BASE_URL=http://127.0.0.1:3002/api
